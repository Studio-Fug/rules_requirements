load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//cc/private:bool_flag.bzl", "bool_flag")

package(default_visibility = ["//visibility:public"])

# `#include "rr_gtest.h"` — RR_VERIFIES / RR_LEVEL / RR_ARTIFACT for googletest.
#
# Header-only and deliberately without a googletest dependency, so this module
# never adds googletest (and its abseil/re2 closure) to a consumer's graph: the
# cc_test using it already depends on the consumer's own googletest.
cc_library(
    name = "gtest",
    hdrs = ["rr_gtest.h"],
    includes = ["."],
)

# `#include "rr_case.h"` — RR_CASE / RR_CHECK / rr::RunCases: per-case JUnit
# for plain-assert C++ tests, each case in its own forked child. Header-only,
# no dependencies.
cc_library(
    name = "case",
    hdrs = ["rr_case.h"],
    includes = ["."],
    deps = select({
        "@bazel_tools//src/conditions:linux": [":gcov_dump_under_coverage"],
        "//conditions:default": [],
    }),
)

# Under `bazel coverage` on Linux, a case child starts its counts from zero
# with __gcov_reset and writes them with __gcov_dump: unlike gcc's __gcov_fork
# and __gcov_exit, these two cover every instrumented shared library as well
# as the executable, whether or not the test's own source is instrumented (by
# default a cc_test links its cc_library deps as shared libraries). gcc's
# libgcov.a keeps each of them in an archive member nothing else pulls in, and
# rr_case.h's weak references cannot pull one in, so the test binary is
# linked with them explicitly. `-u` makes the references strong and GNU ld
# then fails a link that has no definition, so --coverage comes too: the
# runtime is linked even into a test that turns the `coverage` feature off.
# Not tested: clang, whose compiler-rt profile runtime (--coverage and
# -fprofile-instr-generate) defines both as well.
# A toolchain without a gcov runtime cannot link them: such a consumer passes
# --@rules_requirements//cc:coverage_hooks=false; the cases are then counted
# as without the two options (docs/guides/hooks.md).
cc_library(
    name = "gcov_dump_under_coverage",
    linkopts = select({
        ":coverage": [
            "--coverage",
            "-Wl,-u,__gcov_dump",
            "-Wl,-u,__gcov_reset",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:private"],
)

# `--@rules_requirements//cc:coverage_hooks=false` keeps //cc:case from adding
# the gcov link options above under `bazel coverage`.
bool_flag(
    name = "coverage_hooks",
    build_setting_default = True,
)

config_setting(
    name = "coverage",
    flag_values = {":coverage_hooks": "true"},
    values = {"collect_code_coverage": "true"},
    visibility = ["//visibility:private"],
)

exports_files([
    "BUILD.bazel",
    "rr_case.h",
    "rr_gtest.h",
])
