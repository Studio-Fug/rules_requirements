{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-fug.github.io/rules_requirements/schema/rules_requirements.schema.json",
  "title": "rules_requirements model file",
  "description": "A requirements model document: either sections (user_needs, requirements, risks, mitigations, test_methods, config, project) or one object with a `kind`. Referential integrity and coverage rules are checked by `rr validate`, not by this schema.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "not": {
        "required": [
          "kind"
        ]
      },
      "properties": {
        "schema_version": {
          "type": "integer"
        },
        "config": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prefixes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "id_pattern": {
              "type": "string"
            },
            "levels": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "ordered": {
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            },
            "default_level": {
              "type": "string"
            },
            "default_provided_level": {
              "type": "string"
            },
            "autonomous_max_level": {
              "type": "string"
            },
            "pyramid_min_level": {
              "type": "string"
            },
            "pyramid_cheap_levels": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "severities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "likelihoods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptable_risk_score": {
              "type": [
                "integer",
                "null"
              ]
            },
            "high_severities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "error",
                  "warning",
                  "off",
                  false
                ]
              },
              "propertyNames": {
                "not": {
                  "enum": [
                    "attribution-conflict",
                    "bad-selector",
                    "bad-target",
                    "lock-invalid",
                    "lock-owner-changed",
                    "multi-tag",
                    "same-code-multiple-owners",
                    "shared-case",
                    "unknown-target"
                  ]
                },
                "description": "Hard errors and report-time quarantines are not rules and cannot be configured."
              }
            },
            "annotation_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "attribution": {
              "enum": [
                "hybrid",
                "model"
              ],
              "description": "hybrid: a single-id tag may own a case no claim covers; model: only claims own cases."
            },
            "main_repo": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
              "description": "The apparent name of this repository: '@<main_repo>//x:y' means '//x:y'."
            },
            "sets_lock": {
              "type": "string",
              "minLength": 1,
              "description": "The verification-set lock, relative to this file."
            },
            "flaky": {
              "enum": [
                "accept",
                "flag",
                "under-verify",
                "fail"
              ]
            },
            "set_consistency": {
              "enum": [
                "off",
                "warn",
                "enforce",
                false
              ]
            },
            "variants": {
              "type": "array",
              "description": "Groups of targets that run the same test code.",
              "items": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^((@@?[^/]*)?//[^:]*(:.+)?|suite:.+|record:.+)$",
                  "description": "A Bazel label (//pkg:name, @repo//pkg:name; spellings are normalized) or a pseudo-target (suite:<testsuite>, record:<stem>)."
                }
              }
            }
          }
        },
        "project": {
          "type": "object"
        },
        "meta": {
          "type": "object"
        },
        "user_needs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/user_need"
          }
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        },
        "mitigations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mitigation"
          }
        },
        "test_methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/test_method"
          }
        }
      }
    },
    {
      "type": "object",
      "description": "What a user must be able to do (validated).",
      "required": [
        "kind",
        "id",
        "title"
