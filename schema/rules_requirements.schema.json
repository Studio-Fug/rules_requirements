              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "severities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "likelihoods": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptable_risk_score": {
              "type": [
                "integer",
                "null"
              ]
            },
            "high_severities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rules": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "error",
                  "warning",
                  "off"
                ]
              }
            },
            "annotation_patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
