              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "comment",
                      "gap",
                      "question",
                      "todo"
                    ]
                  },
                  "status": {
                    "enum": [
                      "open",
                      "resolved"
                    ]
                  },
                  "author": {
                    "type": "string"
                  },
                  "created": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "rationale": {
          "type": "string"
        },
        "validated_by": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verifiedBy"
          },
          "description": "Validation evidence: claims in the same namespace as verified_by."
        },
        "kind": {
          "const": "user_need"
        }
