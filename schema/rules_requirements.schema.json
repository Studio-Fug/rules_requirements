              }
            },
            "id_pattern": {
              "type": "string"
            },
            "levels": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "ordered": {
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      }
