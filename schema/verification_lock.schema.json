{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studio-fug.github.io/rules_requirements/schema/verification_lock.schema.json",
  "title": "rules_requirements verification-set lock",
  "description": "Generated by `rr sets lock --write`: every locked case of every target mapped to the one entity whose verification set holds it. A case maps to one id, never a list.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema"
  ],
  "properties": {
    "schema": {
      "const": "rules_requirements/verification-lock/v1"
    },
    "cases": {
      "type": [
        "object",
        "null"
      ],
      "propertyNames": {
        "pattern": "^\\s*(?:(?:@@?[A-Za-z0-9_.~+-]*)?//(?:(?:(?!\\.{1,3}(?:[/:]|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+(?:/(?!\\.{1,3}(?:[/:]|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+)*)?:(?!\\.{1,2}(?:/|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+(?:/(?!\\.{1,2}(?:/|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+)*|(?!\\.{1,3}(?:[/:]|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+(?:/(?!\\.{1,3}(?:[/:]|\\s*$))[^\\s#*\"'\\\\/:\\x00-\\x1f\\x7f]+)*)|@@?[A-Za-z0-9_.~+-]+|(?:suite|record):[^#\\n]*[^\\s#][^#\\n]*)\\s*$"
      },
      "additionalProperties": {
        "type": "object",
        "description": "Case path ('[target]' for a synthetic result) -> owner id.",
        "propertyNames": {
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "description": "A canonical case path: NFC, no surrounding blanks."
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^[^,\\s]+$"
        }
      }
    }
  }
}
