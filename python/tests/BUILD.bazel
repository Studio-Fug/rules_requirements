load("@rr_dev_pip//:requirements.bzl", "requirement")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("//rr:defs.bzl", "rr_py_test")

rr_py_test(
    name = "unit_tests",
    size = "medium",
    srcs = glob(["*.py"]),
    data = [
        ":rr_case_fixture",
        "//:docs/_static/logo/rules_requirements_logo.svg",
        "//:docs/_static/logo/rules_requirements_logo-dark.svg",
        "//:schema/rules_requirements.schema.json",
        "//cc:rr_case.h",
    ],
    env = {"RR_CASE_FIXTURE": "$(rootpath :rr_case_fixture)"},
    imports = ["."],  # tests import their shared helpers from conftest
    deps = [
        requirement("pytest"),
        requirement("jsonschema"),
    ],
)

# test_rr_case.py runs this; outside Bazel it compiles the source itself.
cc_binary(
    name = "rr_case_fixture",
    testonly = True,
    srcs = ["data/rr_case_fixture.cc"],
    deps = ["//cc:case"],
)
